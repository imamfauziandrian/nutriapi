{
  "name": "nutriapi-csv-converter",
  "version": "1.0.0",
  "description": "Indonesian Nutrition Data API — CSV to JSON pipeline + Bun HTTP server",
  "type": "module",
  "scripts": {
    "convert": "bun src/convert.ts",
    "merge": "bun src/merge.ts",
    "build:all": "bun src/convert.ts && bun src/merge.ts",
    "start": "bun src/search-api.ts",
    "dev": "bun --watch src/search-api.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
